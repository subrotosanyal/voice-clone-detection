__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
.env
.DS_Store

# fetched at build/setup time, not committed — see
# app/adapters/detectors/vendor/fetch_checkpoint.py. Excluding contents
# via /* (not the bare directory) so the exception below can re-include
# one specific file — git can't un-ignore a file whose parent directory
# is itself excluded.
services/live-call-api/app/adapters/detectors/vendor/checkpoints/*
# Exception: the Hindi-recalibrated output-layer weights are small
# (~3KB), produced entirely in-house by eval/indian_language's own
# fine-tuning pipeline (not a third-party download, no license concern
# the way the base checkpoint's provenance has), and committed directly
# so the exact bytes are inspectable/reproducible from git history — see
# eval/indian_language/README.md for the full process that produced them.
!services/live-call-api/app/adapters/detectors/vendor/checkpoints/AASIST_hindi_finetuned_out_layer.pth

# ECAPA-TDNN speaker-embedding model cache — fetched at build/setup time,
# not committed. See app/adapters/embeddings/fetch_ecapa_model.py.
services/live-call-api/app/adapters/embeddings/.cache/

# Whisper transcription model cache — fetched at build/setup time, not
# committed. See app/adapters/transcription/fetch_whisper_model.py.
services/live-call-api/app/adapters/transcription/.cache/

# Zero-shot intent-classification model cache — fetched at build/setup
# time (active by default — see app/adapters/intent/
# zero_shot_intent_classifier.py's HONESTY NOTE for the known calibration
# caveat this signal carries). Not committed. See
# app/adapters/intent/fetch_intent_model.py.
services/live-call-api/app/adapters/intent/.cache/

# Local LLM (Phi-3-mini GGUF) model cache — fetched at build/setup time,
# not committed. See app/adapters/semantic_risk/fetch_llm_model.py.
services/live-call-api/app/adapters/semantic_risk/.cache/

# session history — local runtime data, not committed. See
# app/adapters/history/sqlite_store.py and docker-compose.yml's volume for it.
services/live-call-api/data/

# Indian-language eval pipeline — fetched/generated audio, not committed
# (see eval/indian_language/README.md). Only results/summary.json (numbers,
# no audio) is tracked.
eval/indian_language/.venv/
# Chatterbox needs its own dedicated venv, separate from the main one
# above — see generate_synthetic_corpus_chatterbox.py's docstring for
# why (a real, confirmed torch/transformers pin conflict with coqui-tts).
eval/indian_language/.venv-chatterbox/
eval/indian_language/data/
eval/indian_language/results/*.wav
eval/indian_language/results/*.pth
