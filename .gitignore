__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
.env
.DS_Store

# fetched at build/setup time, not committed — see
# app/adapters/detectors/vendor/fetch_checkpoint.py
services/live-call-api/app/adapters/detectors/vendor/checkpoints/

# ECAPA-TDNN speaker-embedding model cache — fetched at build/setup time,
# not committed. See app/adapters/embeddings/fetch_ecapa_model.py.
services/live-call-api/app/adapters/embeddings/.cache/

# Whisper transcription model cache — fetched at build/setup time, not
# committed. See app/adapters/transcription/fetch_whisper_model.py.
services/live-call-api/app/adapters/transcription/.cache/

# session history — local runtime data, not committed. See
# app/adapters/history/sqlite_store.py and docker-compose.yml's volume for it.
services/live-call-api/data/

# Indian-language eval pipeline — fetched/generated audio, not committed
# (see eval/indian_language/README.md). Only results/summary.json (numbers,
# no audio) is tracked.
eval/indian_language/.venv/
eval/indian_language/data/
eval/indian_language/results/*.wav
eval/indian_language/results/*.pth
